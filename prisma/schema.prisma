generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Borrow {
  id String @id @default(auto()) @map("_id") @db.ObjectId
}

model StockHistory {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  PN             String
  action         String
  brand          String
  createdAt      DateTime @db.Date
  description    String
  quantityChange BigInt
  source         String
  spec           String
  toolName       String
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime  @default(now())
  name      String
  password  String
  role      String
  userName  String   @unique
}

model request_tool {
  id String @id @default(auto()) @map("_id") @db.ObjectId
}

model stock_toolRoom {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  PN        String
  brand     String
  createdAt DateTime @db.Date
  location  String
  quantity  BigInt
  spec      String
  toolId    String   @db.ObjectId
  toolName  String
}

model stock_warehouse {
  id String @id @default(auto()) @map("_id") @db.ObjectId
}

model toolBroken {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  brokenDate  DateTime @db.Date
  createdAt   DateTime @db.Date
  description String
  quantity    BigInt
  reportedBy  String
  status      String
  toolId      String   @db.ObjectId
  toolName    String
}
